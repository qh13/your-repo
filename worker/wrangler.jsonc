{
  "name": "jable-video-proxy",
  "main": "src/index.js",
  "compatibility_date": "2024-01-01",
  "workers_dev": true,
  "vars": {
    "ORIGIN_DOMAIN": "jable.tv"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jable-videos",
      "database_id": "640ca570-785d-438d-b649-619e4c15266d"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "VIDEO_CACHE",
      "id": "f3c1e9dfd2f0458caa33dd6556932655"
    }
  ],
  "triggers": {
    "crons": [
      "0 * * * *",
      "0 4 * * *"
    ]
  }
}

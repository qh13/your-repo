  "compatibility_date": "2024-01-01",
  "workers_dev": true,
  "vars": {
    "ORIGIN_DOMAIN": "jable.tv"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jable-videos",
